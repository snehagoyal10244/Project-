# NOVARA E-Commerce Environment Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/novara_db?retryWrites=true&w=majority

# JWT Secret & Expiration
JWT_SECRET=novara_super_secret_jwt_key_atelier_2025_luxury_platform
JWT_EXPIRE=30d

# Cookie Secret
COOKIE_SECRET=novara_cookie_atelier_secret_key_98421
